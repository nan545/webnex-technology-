# Replace the placeholders with credentials for a PostgreSQL database you control.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/webnex?schema=public"

# Generate a random secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=""

# Auth.js secret. Generate a separate value using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public origin required by Auth.js in production.
NEXTAUTH_URL="http://localhost:3000"

# Public canonical website origin; set this to the confirmed .com domain at launch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional public click-to-chat contact. Use the company number in international format.
WHATSAPP_BUSINESS_NUMBER=""

# Optional SendGrid outbox delivery. The worker does not send anything unless
# all sender, recipient, and provider credentials are configured.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
NOTIFICATION_TO_EMAIL=""
# Customer acknowledgements remain disabled unless explicitly enabled.
SENDGRID_CUSTOMER_ACKNOWLEDGEMENTS="false"

# Twilio credentials for SMS and WhatsApp assignment alerts.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID=""
NOTIFICATION_DISPATCH_GITHUB_REPOSITORY_ID=""
NOTIFICATION_DISPATCH_GITHUB_WORKFLOW_REF=""

# Optional private object storage for team profile photos. The driver defaults to S3.
# Set the driver to "database" after applying migrations to store images in PostgreSQL.
# For a Render persistent disk, set the driver to "filesystem" and use a disk path.
OBJECT_STORAGE_DRIVER=""
OBJECT_STORAGE_FILESYSTEM_PATH=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
