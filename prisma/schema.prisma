generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum EnquiryActivityType {
  ENQUIRY_RECEIVED
  NOTE_ADDED
  STATUS_CHANGED
  ASSIGNED
  FOLLOW_UP_SET
  FOLLOW_UP_COMPLETED
  PHONE_CONTACT
  EMAIL_CONTACT
  WHATSAPP_LINK_OPENED
  MEETING
  PROPOSAL_CREATED
  PROPOSAL_STATUS_CHANGED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProposalCurrency {
  GHS
  USD
}

enum ContactPreference {
  EMAIL
  PHONE
  EITHER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NavigationLocation {
  HEADER
  FOOTER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  isActive            Boolean   @default(true)
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  roles               UserRole[]
  assignedEnquiries   Enquiry[]         @relation("EnquiryAssignee")
  enquiryActivities   EnquiryActivity[]
  createdFollowUps    FollowUpTask[]    @relation("FollowUpCreator")
  assignedFollowUps   FollowUpTask[]    @relation("FollowUpAssignee")
  createdProposals    Proposal[]        @relation("ProposalCreator")
  enquiryNotes        EnquiryNote[]
  uploadedMedia       MediaAsset[]      @relation("MediaUploader")
  createdServices     Service[]         @relation("ServiceCreator")
  updatedServices     Service[]         @relation("ServiceUpdater")
  serviceRevisions    ServiceRevision[]
  createdProjects     Project[]         @relation("ProjectCreator")
  createdCaseStudies  CaseStudy[]       @relation("CaseStudyCreator")
  createdTeamMembers  TeamMember[]      @relation("TeamMemberCreator")
  createdTestimonials Testimonial[]     @relation("TestimonialCreator")
  createdBlogPosts    BlogPost[]        @relation("BlogPostAuthor")
  createdCategories   Category[]        @relation("CategoryCreator")
  createdTags         Tag[]             @relation("TagCreator")
  createdPages        Page[]            @relation("PageCreator")
  pageRevisions       PageRevision[]    @relation("PageRevisionAuthor")
  siteSettings        SiteSetting[]
  auditLogs           AuditLog[]

  @@index([isActive, lockedUntil])
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  content        Json?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?       @db.VarChar(320)
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?

  createdBy User?          @relation("PageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revisions PageRevision[]

  @@index([status, publishedAt])
}

model PageRevision {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  authorId  String?  @db.Uuid
  revision  Int
  title     String
  content   Json?
  metadata  Json?
  createdAt DateTime @default(now())

  page   Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation("PageRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([pageId, revision])
  @@index([authorId, createdAt])
}

model Service {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  content        Json?
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?       @db.VarChar(320)
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  scheduledAt    DateTime?

  createdBy User?             @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("ServiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  projects  ProjectService[]
  revisions ServiceRevision[]
  redirects ServiceRedirect[]

  @@index([status, sortOrder])
  @@index([publishedAt])
  @@index([scheduledAt])
}

model ServiceRevision {
  id        String        @id @default(uuid()) @db.Uuid
  serviceId String        @db.Uuid
  authorId  String?       @db.Uuid
  revision  Int
  title     String
  slug      String
  summary   String?       @db.Text
  content   Json?
  status    ContentStatus
  createdAt DateTime      @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([serviceId, revision])
  @@index([authorId, createdAt])
}

model ServiceRedirect {
  id         String   @id @default(uuid()) @db.Uuid
  serviceId  String   @db.Uuid
  sourceSlug String   @unique
  createdAt  DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  summary     String?       @db.Text
  clientName  String?
  content     Json?
  industryId  String?       @db.Uuid
  status      ContentStatus @default(DRAFT)
  startedAt   DateTime?
  completedAt DateTime?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  coverImageId String?      @db.Uuid

  createdBy User?            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  coverImage MediaAsset?     @relation("ProjectCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  industry  Industry?        @relation(fields: [industryId], references: [id], onDelete: SetNull)
  services  ProjectService[]
  caseStudy CaseStudy?

  @@index([status, publishedAt])
  @@index([industryId, status, publishedAt])
  @@index([coverImageId])
}

model Industry {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  content        Json?
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?       @db.VarChar(320)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?

  projects Project[]

  @@index([status, sortOrder])
  @@index([publishedAt])
}

model ProjectService {
  projectId String @db.Uuid
  serviceId String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

model CaseStudy {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  summary     String?       @db.Text
  content     Json?
  outcomes    Json?
  status      ContentStatus @default(DRAFT)
  projectId   String?       @unique @db.Uuid
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CaseStudyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model TeamMember {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  title            String
  biography        String?       @db.Text
  email            String?
  profileUrl       String?
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  createdById      String?       @db.Uuid
  slug             String        @unique
  department       String?       @db.VarChar(120)
  linkedinUrl      String?       @db.VarChar(2048)
  githubUrl        String?       @db.VarChar(2048)
  portfolioUrl     String?       @db.VarChar(2048)
  otherSocialLinks Json?
  isActive         Boolean       @default(true)
  profileImageId   String?       @db.Uuid
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy    User?       @relation("TeamMemberCreator", fields: [createdById], references: [id], onDelete: SetNull)
  profileImage MediaAsset? @relation("TeamMemberProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  @@index([status, isActive, sortOrder])
  @@index([profileImageId])
}

model Testimonial {
  id           String        @id @default(uuid()) @db.Uuid
  quote        String        @db.Text
  authorName   String
  authorTitle  String?
  organization String?
  status       ContentStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publishedAt  DateTime?

  createdBy User? @relation("TestimonialCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@index([publishedAt])
}

model BlogPost {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  excerpt        String?       @db.Text
  content        Json?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?       @db.VarChar(320)
  authorId       String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  coverImageId   String?       @db.Uuid

  author     User?              @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  coverImage MediaAsset?        @relation("BlogPostCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  categories BlogPostCategory[]
  tags       BlogPostTag[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([coverImageId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  createdBy User?              @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts     BlogPostCategory[]

  @@index([name])
}

model BlogPostCategory {
  blogPostId String @db.Uuid
  categoryId String @db.Uuid

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogPostId, categoryId])
  @@index([categoryId])
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  createdBy User?         @relation("TagCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts     BlogPostTag[]

  @@index([name])
}

model BlogPostTag {
  blogPostId String @db.Uuid
  tagId      String @db.Uuid

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@index([tagId])
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  width        Int?
  height       Int?
  altText      String   @default("")
  caption      String?  @db.Text
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  uploadedBy  User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  teamMembers TeamMember[] @relation("TeamMemberProfileImage")
  projectCovers Project[] @relation("ProjectCoverImage")
  blogPostCovers BlogPost[] @relation("BlogPostCoverImage")

  @@index([uploadedById, createdAt])
  @@index([mimeType])
}

model StoredMediaObject {
  storageKey String   @id @db.VarChar(500)
  data       Bytes
  createdAt  DateTime @default(now())
}

model Enquiry {
  id                String            @id @default(uuid()) @db.Uuid
  reference         String            @unique @db.VarChar(32)
  name              String
  email             String
  organization      String?
  phone             String?
  legacySubject     String?
  legacyStatus      String?           @db.VarChar(32)
  service           String            @db.VarChar(120)
  budget            String?           @db.VarChar(120)
  preferredContact  ContactPreference
  message           String            @db.Text
  sourcePath        String?
  privacyConsentAt  DateTime?
  followUpAt        DateTime?
  lastContactAt     DateTime?
  whatsappConsentAt DateTime?
  idempotencyKey    String?           @unique @db.Uuid
  status            EnquiryStatus     @default(NEW)
  assignedToId      String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  assignedTo    User?                @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes         EnquiryNote[]
  notifications NotificationOutbox[]
  activities    EnquiryActivity[]
  followUps     FollowUpTask[]
  proposals     Proposal[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([email])
  @@index([followUpAt])
}

model EnquiryActivity {
  id          String              @id @default(uuid()) @db.Uuid
  enquiryId   String              @db.Uuid
  actorId     String?             @db.Uuid
  type        EnquiryActivityType
  description String              @db.VarChar(1000)
  metadata    Json?
  createdAt   DateTime            @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model FollowUpTask {
  id           String    @id @default(uuid()) @db.Uuid
  enquiryId    String    @db.Uuid
  assignedToId String?   @db.Uuid
  createdById  String?   @db.Uuid
  title        String    @db.VarChar(160)
  description  String?   @db.Text
  dueAt        DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enquiry    Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assignedToId, completedAt, dueAt])
  @@index([enquiryId, dueAt])
}

model Proposal {
  id             String           @id @default(uuid()) @db.Uuid
  enquiryId      String           @db.Uuid
  createdById    String?          @db.Uuid
  title          String           @db.VarChar(200)
  scope          String           @db.Text
  estimatedPrice Decimal          @db.Decimal(18, 2)
  currency       ProposalCurrency
  status         ProposalStatus   @default(DRAFT)
  issueDate      DateTime         @db.Date
  expiryDate     DateTime?        @db.Date
  internalNotes  String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@index([status, expiryDate])
}

model EnquiryNote {
  id         String   @id @default(uuid()) @db.Uuid
  enquiryId  String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String   @db.Text
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@index([authorId])
}

model SiteSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model NotificationOutbox {
  id                String             @id @default(uuid()) @db.Uuid
  enquiryId         String             @db.Uuid
  event             String             @db.VarChar(80)
  payload           Json
  status            NotificationStatus @default(PENDING)
  attemptCount      Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  lastError         String?            @db.VarChar(500)
  sentAt            DateTime?
  providerMessageId String?            @db.VarChar(200)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@unique([enquiryId, event])
  @@index([status, nextAttemptAt])
}

model RateLimitBucket {
  id           String   @id @default(uuid()) @db.Uuid
  identifier   String   @db.VarChar(64)
  bucketStart  DateTime
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([identifier, bucketStart])
  @@index([bucketStart])
}

model NavigationItem {
  id         String             @id @default(uuid()) @db.Uuid
  label      String
  href       String
  location   NavigationLocation
  sortOrder  Int                @default(0)
  isVisible  Boolean            @default(true)
  isExternal Boolean            @default(false)
  parentId   String?            @db.Uuid
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  parent   NavigationItem?  @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavigationHierarchy")

  @@index([location, isVisible, sortOrder])
  @@index([parentId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
