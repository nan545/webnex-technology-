{
  "name": "webnex-technologies",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import dotenv/config --import tsx --test tests/admin-idle-session.test.ts tests/enquiry-validation.test.ts tests/enquiry-route.test.ts tests/cms-service-validation.test.ts tests/phase6-validation.test.ts tests/team-member.test.ts tests/filesystem-object-storage.test.ts tests/media-library.test.ts tests/work-projects.test.ts tests/whatsapp.test.ts tests/site-configuration.test.ts tests/admin-password-reset.test.ts tests/admin-password-reset-db.test.ts tests/role-management.test.ts tests/publications.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:check": "node --conditions=react-server --import dotenv/config --import tsx scripts/check-database.ts",
    "admin:bootstrap": "node --conditions=react-server --import dotenv/config --import tsx scripts/bootstrap-super-admin.ts",
    "admin:reset-password": "node --conditions=react-server --import dotenv/config --import tsx scripts/reset-admin-password.ts",
    "email:dispatch": "node --conditions=react-server --import dotenv/config --import tsx scripts/dispatch-email-outbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
